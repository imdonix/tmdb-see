# ── Core ─────────────────────────────────────────────────────────────────────
PORT=8080
DATA_DIR=./data
# Optional. If unset, a random key is generated at DATA_DIR/secret.key.
# Set this to keep encrypted provider credentials stable across fresh volumes.
# APP_SECRET=change-me-to-a-long-random-string

# ── TMDB ─────────────────────────────────────────────────────────────────────
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# ── Default nCore provider (seeded on first boot) ───────────────────────────
# NCORE_HOST points at an ncore-go compatible API, e.g. http://ncore:8080
NCORE_HOST=http://localhost:1001
NCORE_USER=
NCORE_PASS=

# Optional second provider (Torznab / Prowlarr / Jackett)
# TORZNAB_NAME=Prowlarr
# TORZNAB_URL=http://prowlarr:9696/1/api
# TORZNAB_API_KEY=

# ── qBittorrent ──────────────────────────────────────────────────────────────
QBIT_HOST=http://localhost:1002
QBIT_USER=admin
QBIT_PASS=adminadmin
# Base path inside qBittorrent's filesystem. See writes Movies/ and TV Shows/
# beneath it when the Jellyfin folder layout is enabled.
QBIT_SAVE_PATH=/downloads
QBIT_ORGANIZE=true

# ── Ollama Cloud / Ollama ────────────────────────────────────────────────────
AI_ENABLED=false
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
AI_VERIFY_DOWNLOADS=false
AI_VERIFY_FOLLOWS=false
AI_THRESHOLD=0.75

# ── Scheduler ────────────────────────────────────────────────────────────────
FOLLOW_INTERVAL_MINUTES=60
# DISABLE_SCHEDULER=1
